<Project>
    <PropertyGroup>
        <!-- Keep this a plain x.y.z: mod manifests' loaderVersion is compared against it with semver rules,
             and a pre-release suffix such as -net10 would rank below x.y.z and reject mods that require it. -->
        <VersionPrefix>0.9.1</VersionPrefix>
        <Authors>BepInEx, Toni Macaroni</Authors>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DebugType>embedded</DebugType>
        <Configurations>Debug;Release</Configurations>
        <RepositoryUrl>https://github.com/ToniMacaroni/RedLoader</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <BuildDir>$(SolutionDir)bin</BuildDir>
        
        <Cpp2IlVersion>2022.1.0-pre-release.19</Cpp2IlVersion>
        <Il2CppInteropVersion>1.4.6-ci.602</Il2CppInteropVersion>

        <ProjectAlias>_Redloader</ProjectAlias>
        <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sons Of The Forest</GamePath>
        <!-- .NET target for the loader, SDK and Il2CppInterop; LoaderNetFolder is the runtime folder name under _Redloader -->
        <LoaderTfm>net10.0</LoaderTfm>
        <LoaderNetFolder>net10</LoaderNetFolder>
    </PropertyGroup>
</Project>
